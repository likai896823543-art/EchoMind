# EchoMind 环境变量示例（复制为 .env 后填写真实值，切勿提交 .env）

# 模型服务（Anthropic 协议兼容，支持 Claude / DeepSeek 等）
ANTHROPIC_API_KEY=your_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# 应用
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Redis（工作记忆）
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@redis:6379/0

# ChromaDB（情景记忆与向量检索）
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/data/chroma

# 监控（Prometheus）
PROMETHEUS_PORT=9090
MONITOR_INTERVAL=60

# 告警 Webhook（可选）
ALERT_WEBHOOK_URL=
